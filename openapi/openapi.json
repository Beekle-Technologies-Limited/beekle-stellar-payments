  "info": {
    "title": "Beekle Stellar payments",
    "description": "Watch-only Stellar checkout. Testnet by default. Customer wallets sign. This service does not submit customer payments or store Stellar seeds.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "admin": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token"
      }
    },
    "schemas": {
      "DemoCheckoutDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "example": "10.0000000"
          },
          "stellar_destination": {
            "type": "string",
            "description": "Existing funded testnet account. Omit to preview an unfunded watch-only address."
          }
        }
      },
      "CreateMerchantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Northwind Goods"
          },
          "stellar_destination": {
            "type": "string",
            "example": "GD6WU64XHG2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y4Q2Y",
            "description": "Merchant self-custody account. Public key only."
          },
          "webhook_url": {
            "type": "string",
            "example": "http://127.0.0.1:9099/hooks/beekle",
            "description": "Registered callback. Allowlisted hosts only. Not taken from payment requests."
          }
        },
        "required": [
          "name",
          "stellar_destination"
        ]
      },
      "CreateIntentDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "example": "25.5000000",
            "description": "Fixed-point decimal string, max 7 places."
          },
          "asset_code": {
            "type": "string",
            "example": "USDC"
          },
          "asset_issuer": {
            "type": "string",
            "example": "GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5",
            "description": "Required for issued assets. Omit only for native XLM when XLM is accepted."
          },
          "merchant_order_ref": {
            "type": "string",
            "example": "order-1001"
          },
          "expires_in_seconds": {
            "type": "number",
            "example": 1800
          }
        },
        "required": [
          "amount",
          "asset_code"
        ]
      },
      "CursorDto": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "example": ""
          }
        },
        "required": [
          "account_id",
          "cursor"
        ]
      },
      "BackfillDto": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "max_pages": {
            "type": "number",
            "example": 5
          },
          "from_cursor": {
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ]
      },
      "ExternalRefundDto": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "example": "Merchant refunded from their own wallet"
          },
          "external_reference": {
            "type": "string",
            "example": "off-platform-ref-42"
          }
        },
        "required": [
          "note",
          "external_reference"
        ]
      }
    }
  }
}
