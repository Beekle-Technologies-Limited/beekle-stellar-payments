# Local development only. These values are not production secrets.
# Copy to .env. Do not put mainnet keys, signer seeds, or live webhook secrets here.

NODE_ENV=development
PORT=4317
PUBLIC_BASE_URL=http://127.0.0.1:4317

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=beekle
DB_PASSWORD=beekle_dev_only
DB_NAME=beekle_stellar
DB_MIGRATE_ON_BOOT=false

# Official testnet. The service refuses to boot if the passphrase does not match.
# https://developers.stellar.org/docs/networks
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ALLOW_MAINNET=false
STELLAR_HORIZON_ALLOW_UNOFFICIAL=false

# Circle-published Stellar testnet USDC. Not a Beekle-issued token.
# https://developers.circle.com/stablecoins/usdc-contract-addresses
# Retrieved 2026-11-07. Re-check after a Stellar testnet reset.
ACCEPTED_ASSETS=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

OBSERVER_ENABLED=true
OBSERVER_POLL_MS=5000
OBSERVER_PAGE_LIMIT=50
EXPIRY_WORKER_ENABLED=true
WEBHOOK_WORKER_ENABLED=true

# Demo fail-closed: only these hosts can receive webhooks.
# Public HTTPS stays off until a real merchant host is listed.
WEBHOOK_HOST_ALLOWLIST=localhost,127.0.0.1
WEBHOOK_ALLOW_PUBLIC_HTTPS=false
WEBHOOK_TIMEOUT_MS=5000

# Webhook HMAC secrets are stored as AES-256-GCM ciphertext.
# Production (NODE_ENV=production) refuses to start unless this is 32 bytes of base64.
# Do not commit a real key. This example does not contain one.
# WEBHOOK_ENCRYPTION_KEY=
# Local process only. Refused when NODE_ENV=production.
# The key stays in memory, is not logged, and ciphertext will not decrypt after restart.
WEBHOOK_SECRETS_DEV_MODE=local

# Placeholder for local admin routes. Replace it before any shared deployment.
ADMIN_TOKEN=replace-with-a-long-random-token
DEMO_OPEN_REGISTRATION=true
